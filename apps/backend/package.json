{
  "name": "gym-app-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "yarn typecheck && yarn tsc && copyfiles -f src/**/*.prisma dist/",
    "lint": "eslint src",
    "typecheck": "yarn tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.79.2",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.11.1",
    "zod": "^3.22.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.15.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
